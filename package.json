{
  "name": "warp",
  "version": "0.4.0",
  "private": true,
  "description": "A local-first radial file converter for Windows",
  "author": "Warp contributors",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "node scripts/create-icon.cjs && vite build && tsc -p tsconfig.electron.json && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run prepare:engine && npm run build && electron-builder --win nsis --x64",
    "prepare:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-engine.ps1",
    "test:engine": "tsx --test tests/engine.integration.ts",
    "test:visual": "electron scripts/visual-smoke.cjs",
    "test:runtime": "electron scripts/runtime-smoke.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "io.warp.converter",
    "productName": "Warp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/SelectionWatcher.exe",
        "to": "SelectionWatcher.exe"
      },
      {
        "from": "vendor/libreoffice",
        "to": "libreoffice",
        "filter": [
          "**/*"
        ]
      },
      {
        "to": "THIRD-PARTY-NOTICES.md",
        "from": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/warp.ico",
      "signExecutable": false
    },
    "nsis": {
      "allowElevation": false,
      "artifactName": "Warp-Setup-${version}.${ext}",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "perMachine": false,
      "oneClick": true,
      "include": "scripts/installer.nsh"
    }
  }
}
