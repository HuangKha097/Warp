{
  "name": "warp",
  "version": "0.6.0",
  "private": true,
  "description": "A local-first radial file converter for Windows",
  "author": "Warp contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/create-icon.cjs && vite build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "start": "node scripts/tauri.cjs dev",
    "tauri": "node scripts/tauri.cjs",
    "check": "tsc --noEmit",
    "check:rust": "node scripts/cargo.cjs check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "node scripts/cargo.cjs test --manifest-path src-tauri/Cargo.toml",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "package": "npm run prepare:engine && node scripts/tauri.cjs build --bundles nsis",
    "prepare:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-engine.ps1",
    "test:engine": "node scripts/cargo.cjs test --manifest-path src-tauri/Cargo.toml --test engine -- --ignored",
    "test:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-runtime.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
