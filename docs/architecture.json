    {"dot":"cyan","title":"Điều khiển và giao diện","items":["Helper là tiến trình C# riêng, được giám sát và khởi động lại khi lỗi.","Electron main, hàng đợi và điều phối chuyển đổi cùng nằm trong tiến trình main.","Renderer dùng preload cách ly; yêu cầu chuyển đổi phải đến từ overlay và đúng đích được phép."]},
    {"dot":"emerald","title":"Bảo toàn tài liệu","items":["Bộ chuyển đổi chỉ nhận bản sao tạm của tệp nguồn.","Kết quả được tạo bằng COPYFILE_EXCL; tên trùng được thêm số.","Không có server/database; hàng đợi không được lưu lại sau khi thoát."]},
    {"dot":"slate","title":"Phạm vi sơ đồ","items":["Tổng quan luồng chuyển đổi trên Windows; không mô tả pipeline build hoặc cài đặt.","Lỗi chuyển đổi được đưa về bảng tiến trình; người dùng có thể thử lại.","Nội dung tiếng Việt; một số điều khiển nâng cao của trình xem dùng tiếng Anh."]}
